# Plantilla de variables. Instalar.bat crea el archivo .env real (local, no se versiona); tambien puede copiar este a mano:
#   copy .env.example .env
# NO suba .env a git ni lo incluya en el ZIP de entrega.

# Proveedor de IA: local (por defecto, sin internet) | groq | gemini
LLM_PROVIDER=local

# Solo se necesita la del proveedor elegido
GEMINI_API_KEY=
GROQ_API_KEY=

# Base de datos del Asistente (SQLite + sqlite-vec en un solo archivo). Informativa: la ruta real la fija config/settings.toml
DATABASE_URL=sqlite:///data/chat/index.db
